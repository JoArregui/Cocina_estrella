# Desarrollo local solamente — NO commitear el .env real
# OPCIÓN ÓPTIMA (FREE): Muse Spark / Nemotron vía OpenRouter (100% free, sin tarjeta)
# Consigue key gratis en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...placeholder
# AI_PROVIDER: muse-spark (default, rápido/español) | nemotron (más reasoning) | auto
AI_PROVIDER=muse-spark
# AI_MODEL opcional override: meta-llama/llama-3.2-3b-instruct:free | nvidia/llama-3.1-nemotron-70b-instruct:free | meta-llama/llama-3.2-11b-vision-instruct:free
# AI_MODEL=

# Fallback Gemini (si no usas OpenRouter) — requiere proyecto Google Cloud
# GEMINI_API_KEY=AIza_placeholder
# Opcional: proxy backend que custodia la key (recomendado producción)
# GEMINI_PROXY_URL=https://tu-cloud-run.com/gemini

# Recomendado: usar OpenRouter free en dev y proxy en prod:
# flutter run --dart-define=OPENROUTER_API_KEY=sk-or-... --dart-define=AI_PROVIDER=muse-spark
# flutter build apk --dart-define=GEMINI_PROXY_URL=https://tu-proxy.com

# TheMealDB no requiere key (pública)
# Spoonacular (opcional, +5k recetas): https://spoonacular.com/food-api (150 req/día free)
# SPOONACULAR_API_KEY=abc123...

# Búsqueda web automática en detalle receta (opcional, 100% free sin key con fallback curado)
# Si defines una, hará búsqueda real con 5-10 resultados; si no, genera enlaces curados (Google, YouTube, etc.)
# BRAVE_API_KEY=...  # https://brave.com/search/api/ (2000 req/mes free)
# BING_API_KEY=...   # https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
# SERPAPI_API_KEY=... # https://serpapi.com/
